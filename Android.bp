// Soong build for the FDE Launcher taskbar plugin. The Gradle build (see
// build.gradle, app/build.gradle) keeps working on its own and is not affected
// by this file.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// ---------------------------------------------------------------------------
// Third-party libraries that are not available as Soong modules in the AOSP
// tree. These are the exact artifacts used by the Gradle build.
// ---------------------------------------------------------------------------

android_library_import {
    name: "fdetaskbar-glide",
    aars: ["prebuilts/glide-4.12.0.aar"],
}

java_import {
    name: "fdetaskbar-glide-annotations",
    jars: ["prebuilts/glide-annotations-4.12.0.jar"],
}

java_import {
    name: "fdetaskbar-glide-disklrucache",
    jars: ["prebuilts/glide-disklrucache-4.12.0.jar"],
}

android_library_import {
    name: "fdetaskbar-glide-gifdecoder",
    aars: ["prebuilts/glide-gifdecoder-4.12.0.aar"],
}

java_import {
    name: "fdetaskbar-androidsvg",
    jars: ["prebuilts/androidsvg-1.4.jar"],
}

android_library_import {
    name: "fdetaskbar-magicindicator",
    aars: ["prebuilts/MagicIndicator-1.7.0.aar"],
}

android_library_import {
    name: "fdetaskbar-okhttputils",
    aars: ["prebuilts/okHttpUtils-1.3.0.aar"],
}

java_import {
    name: "fdetaskbar-okhttp",
    jars: ["prebuilts/okhttp-3.5.0.jar"],
}

java_import {
    name: "fdetaskbar-okio",
    jars: ["prebuilts/okio-1.11.0.jar"],
}

java_import {
    name: "fdetaskbar-pinyin4j",
    jars: ["prebuilts/pinyin4j-2.5.1.jar"],
}

android_library_import {
    name: "fdetaskbar-viewpager",
    aars: ["prebuilts/viewpager-1.0.0.aar"],
}

// ---------------------------------------------------------------------------
// FdeTaskbar: the FDE Launcher taskbar plugin.
// Replaces the prebuilt FdeTaskPlugin.apk (module FdeTaskbar) that the device
// tree used to install.
// ---------------------------------------------------------------------------

android_app {
    name: "FdeTaskbar",
    package_name: "com.fde.taskplugin",

    srcs: [
        "app/src/main/java/**/*.java",
        "app/src/main/java/**/*.kt",
    ],

    manifest: "app/src/main/AndroidManifest.xml",
    resource_dirs: ["app/src/main/res"],

    static_libs: [
        // SystemUI shared library: plugin API, plugin core, Kotlin stdlib...
        "SystemUISharedLib",
        // Launcher plugin interfaces (TaskbarPlugin, ...)
        "LauncherPluginLib",

        // AndroidX/Material dependencies that exist as Soong modules
        "androidx.appcompat_appcompat",
        "androidx.cardview_cardview",
        "androidx.core_core-ktx",
        "androidx.fragment_fragment",
        "androidx.preference_preference",
        "androidx.recyclerview_recyclerview",
        "androidx.room_room-runtime",
        "androidx.sqlite_sqlite",
        "androidx-constraintlayout_constraintlayout",
        "com.google.android.material_material",
        "kotlinx_coroutines",
        "kotlinx_coroutines_android",
        "gson",

        // Prebuilt third-party libraries (see above)
        "fdetaskbar-glide",
        "fdetaskbar-glide-annotations",
        "fdetaskbar-glide-disklrucache",
        "fdetaskbar-glide-gifdecoder",
        "fdetaskbar-androidsvg",
        "fdetaskbar-magicindicator",
        "fdetaskbar-okhttputils",
        "fdetaskbar-okhttp",
        "fdetaskbar-okio",
        "fdetaskbar-pinyin4j",
        "fdetaskbar-viewpager",
    ],
    // Room annotation processing (kapt for Kotlin, javac for Java)
    plugins: ["androidx.room_room-compiler-plugin"],

    platform_apis: true,
    min_sdk_version: "current",
    target_sdk_version: "current",

    certificate: "platform",
    privileged: true,
    system_ext_specific: true,

    // Keep the version information of the Gradle build.
    aaptflags: [
        "--version-code",
        "1",
        "--version-name",
        "1.0",
    ],

    optimize: {
        enabled: false,
    },
}
